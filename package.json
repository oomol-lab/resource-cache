{
  "name": "@oomol-lab/resource-cache",
  "version": "0.1.1",
  "description": "Persistent and session-scoped resource caching with freshness tracking and conditional revalidation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oomol-lab/resource-cache.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./oomol": {
      "require": {
        "types": "./dist/oomol.d.cts",
        "default": "./dist/oomol.cjs"
      },
      "import": {
        "types": "./dist/oomol.d.mts",
        "default": "./dist/oomol.mjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:ci": "biome ci",
    "ts-check": "tsc --noEmit",
    "ts-watch": "tsc --noEmit -w",
    "docs": "typedoc --options typedoc.json && biome format --write --config-path=biome.docs.json --files-ignore-unknown=true docs",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --coverage.reportsDirectory='./docs/coverage'",
    "build": "tsdown",
    "build:min": "MINIFY=true tsdown && echo '' && gzip-size dist/index.mjs dist/index.js",
    "release": "commit-and-tag-version",
    "test:package": "npm run build && node scripts/check-package.mjs"
  },
  "keywords": [
    "cache",
    "resource-cache",
    "indexeddb",
    "sessionstorage",
    "etag",
    "ttl",
    "conditional-requests",
    "typescript"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "@wopjs/gzip-size": "^0.1.5",
    "commit-and-tag-version": "^13.2.1",
    "fake-indexeddb": "^6.2.5",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0"
  }
}
